<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#262626"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloAprendizaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_aprendizaje"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_gris">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/funcion_cuadratica"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLeccionCuadratica"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="18dp"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_amarillo"
                android:backgroundTint="@null"
                android:text="@string/iniciar_leccion"
                android:drawableEnd="@drawable/ico_flecha"
                android:drawablePadding="12dp"
                android:textColor="#262626"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_gris">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/funcion_logaritmica"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLeccionLogaritmica"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="18dp"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_amarillo"
                android:backgroundTint="@null"
                android:text="@string/iniciar_leccion"
                android:drawableEnd="@drawable/ico_flecha"
                android:drawablePadding="12dp"
                android:textColor="#262626"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_gris">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/funciones_trigonometricas"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLeccionTrigonometrica"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="18dp"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_amarillo"
                android:backgroundTint="@null"
                android:text="@string/iniciar_leccion"
                android:drawableEnd="@drawable/ico_flecha"
                android:drawablePadding="12dp"
                android:textColor="#262626"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_gris">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/funcion_coseno"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLeccionCoseno"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginTop="18dp"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:background="@drawable/btn_amarillo"
                android:backgroundTint="@null"
                android:text="@string/iniciar_leccion"
                android:drawableEnd="@drawable/ico_flecha"
                android:drawablePadding="12dp"
                android:textColor="#262626"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>
