<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <!-- Título -->
        <TextView
            android:id="@+id/txtTituloFunciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/encabezadofuncion"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulofuncion"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/definicionfuncion"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ejemplofuncion"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulonotacion"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/notacion1"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/notacion2"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/notacion3"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/notacion4"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/conceptosclaves"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulodominio"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/definiciondominio"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulorango"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/definicionrango"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/conceptopareja"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <!-- Ejemplo -->
        <TextView
            android:id="@+id/txtEjemploFunciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ejemplopareja"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:background="@color/divisor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tituloescuchargrafica"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/definicionescuchargrafica"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <!-- Plano cartesiano que recorre la gráfica mientras suena -->

        <com.example.sara.PlanoSonoroView

            android:id="@+id/planoSonoro"

            android:layout_width="match_parent"

            android:layout_height="260dp"

            android:layout_marginTop="20dp" />


        <!-- Botón sonido -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSonidoFunciones"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/btn_amarillo"
            android:text="Reproducir sonido "
            android:drawableEnd="@drawable/ico_reproducir"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Regresar: vuelve al panel de Aprendizaje -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_gravity="start"
            android:layout_marginTop="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="25dp"
            android:background="@drawable/btn_contorno"
            android:drawableStart="@drawable/ico_regresar"
            android:drawablePadding="8dp"
            android:text="@string/regresar"
            android:contentDescription="@string/regresaraprendizaje"
            android:drawableTint="@color/amarillo"
            android:textColor="@color/amarillo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Espacio final -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>
