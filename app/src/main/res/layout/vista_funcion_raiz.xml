<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:id="@+id/txtTituloRaiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/encabezadoraiz"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:id="@+id/txtFormaRaiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/formaraiz"
            android:textColor="@color/amarillo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tituloparametros"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/parametroraiz1"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/parametroraiz2"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/parametroraiz3"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulografica"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/graficaraiz"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulocaracteristicas"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/caracteristicaraiz1"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/caracteristicaraiz2"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/caracteristicaraiz3"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:text="@string/caracteristicaraiz4"
            android:textColor="@color/texto_secundario"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/txtEjemploRaiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ejemploraiz"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:background="@color/divisor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tituloescuchargrafica"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true" />

        <com.example.sara.PlanoSonoroView
            android:id="@+id/planoSonoro"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="20dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSonidoRaiz"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:background="@drawable/btn_amarillo"
            android:text="Reproducir sonido "
            android:drawableEnd="@drawable/ico_reproducir"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_gravity="start"
            android:layout_marginTop="40dp"
            android:paddingStart="20dp"
            android:paddingEnd="25dp"
            android:background="@drawable/btn_contorno"
            android:drawableStart="@drawable/ico_regresar"
            android:drawablePadding="8dp"
            android:text="@string/regresar"
            android:contentDescription="@string/regresaraprendizaje"
            android:drawableTint="@color/amarillo"
            android:textColor="@color/amarillo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <!-- Espacio final -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>
