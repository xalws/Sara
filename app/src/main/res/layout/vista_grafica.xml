<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#262626"
    android:fillViewport="true"
    android:scrollbars="none"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center_horizontal"
        >

<!--    Titulo -->
    <TextView
        android:id="@+id/txtTituloGraficacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Graficación"
        android:textSize="40sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp"/>

<!--        Contenedor para cargar API de geogebra  -->
        <WebView
            android:id="@+id/contenedorGeogebra"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:background="#FFFFFF"
            />

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp"/>

<!--        Entrada de la funcion  -->
        <EditText
            android:id="@+id/etFuncion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresa la función a graficar"
            android:textColorHint="#4d4d4d"
            android:backgroundTint="#4f4f4f"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:inputType="textNoSuggestions"
            android:paddingBottom="15dp"
            />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp"/>

<!--        Botones  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGraficar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/btn_amarillo"
                android:text="Graficar"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:layout_marginEnd="10dp"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReproducirGrafica"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/btn_morado"
                android:text="Reproducir"
                android:textColor="@color/black"
                android:textSize="21sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                />

        </LinearLayout>

    </LinearLayout>
</ScrollView>